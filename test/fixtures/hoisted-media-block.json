{
  "_comment": "What a hoisted @media block compiles to when only its first rule keeps the condition: sm:block holds 640, everything after it drops to 0. This is the shape uniwind produced with tailwindcss 4.3.3 before v1.12.1.",
  "ios": {
    "flex": [{ "className": "flex", "minWidth": 0 }],
    "sm:block": [{ "className": "sm:block", "minWidth": 640 }],
    "sm:hidden": [{ "className": "sm:hidden", "minWidth": 0 }],
    "sm:flex-row": [{ "className": "sm:flex-row", "minWidth": 0 }],
    "lg:flex": [{ "className": "lg:flex", "minWidth": 1024 }],
    "lg:gap-4": [{ "className": "lg:gap-4", "minWidth": 0 }],
    "ios:-mt-12": [{ "className": "ios:-mt-12", "minWidth": 0 }]
  },
  "android": {
    "flex": [{ "className": "flex", "minWidth": 0 }],
    "sm:block": [{ "className": "sm:block", "minWidth": 640 }],
    "sm:hidden": [{ "className": "sm:hidden", "minWidth": 0 }],
    "sm:flex-row": [{ "className": "sm:flex-row", "minWidth": 0 }],
    "lg:flex": [{ "className": "lg:flex", "minWidth": 1024 }],
    "lg:gap-4": [{ "className": "lg:gap-4", "minWidth": 0 }],
    "ios:-mt-12": [{ "className": "ios:-mt-12", "minWidth": 0 }],
    "android:pt-6": [{ "className": "android:pt-6", "minWidth": 0 }]
  }
}
